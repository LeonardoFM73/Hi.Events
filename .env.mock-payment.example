# Mock Payment Configuration Example
# Add these to your .env file if needed

# Enable/Disable Mock Payment (optional)
MOCK_PAYMENT_ENABLED=true

# Mock Payment Auto Success Delay (in seconds, optional)
# Set to 0 for instant success
MOCK_PAYMENT_DELAY=0

# Mock Payment Default Status (optional)
# Options: success, failed
MOCK_PAYMENT_DEFAULT_STATUS=success

# Enable Mock Payment Logging (optional)
MOCK_PAYMENT_LOGGING=true

# Note: Mock payment works without any configuration
# These are optional settings for advanced usage
