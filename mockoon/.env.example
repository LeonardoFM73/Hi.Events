# Xendit Configuration for Mock API
# Copy this to your .env file and update the values

# Xendit API Key (for mock, any value works)
XENDIT_API_KEY=test_api_key

# Xendit Webhook Token (for mock, any value works)
XENDIT_WEBHOOK_TOKEN=test_webhook_token

# Xendit Base URL
# For production: https://api.xendit.co
# For local testing with Mockoon: http://mockoon:3000 (inside Docker network)
# For local testing without Docker: http://localhost:3000
XENDIT_BASE_URL=http://mockoon:3000
